{
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": false,
    "module": "CommonJS",
    "target": "ES2017",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "./types/mediaType.d.ts",
      "./types/plugin.d.ts",
      "./types/nanoMeting.d.ts"
    ]
  },
  "include": [
    "./types/*",
    "./src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}